ALEO_PRIVATE_KEY_FILE=/secure/path/account.privatekey
# Scan-only alternative: disable every AUTOJOIN_* setting below, unset
# ALEO_PRIVATE_KEY_FILE, and set ALEO_VIEW_KEY_FILE to a protected view-key file.
# ALEO_VIEW_KEY_FILE=/secure/path/account.viewkey
ALEO_NETWORK=testnet
SCAN_START_BLOCK=0
# Wait for the initial historical scan before reading records or joining.
SCAN_SYNC_POLL_INTERVAL_MS=5000
SCAN_SYNC_TIMEOUT_MS=300000
# Optional ciphertext snapshot. The scanner remains the source of truth.
RECORD_STORE_FILE=
# Defaults to true because a per-account ciphertext set reveals ownership.
RECORD_STORE_PRIVATE=true
# Optional owner-only snapshot containing decrypted records for transaction inputs.
DECRYPTED_RECORD_STORE_FILE=

# Broadcast consolidation is enabled for every supported family by default.
AUTOJOIN_CREDITS=true
AUTOJOIN_USDCX=true
AUTOJOIN_ARC20_ETH=true
AUTOJOIN_ARC20_SOL=true
AUTOJOIN_ARC20_WBTC=true
AUTOJOIN_POLL_INTERVAL_MS=5000
AUTOJOIN_TIMEOUT_MS=300000

# Optional record filters. Leave empty to return every record type.
RECORD_PROGRAM=
RECORD_NAME=
